# Copy to .env and fill in. Both are OPTIONAL — the core
# upload -> detect -> 3D pipeline runs without any keys.

# Unsplash: powers interior inspiration + color-palette extraction.
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Sketchfab: powers downloadable 3D furniture assets (GLB).
# https://sketchfab.com/settings/password
SKETCHFAB_API_TOKEN=
